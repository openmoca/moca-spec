    { "package": "conformance/fixtures/review-wrong-role", "key": "publisher" },
    { "package": "conformance/fixtures/search-policy/v2", "key": "publisher" },
    { "package": "conformance/fixtures/search-conflict/rival", "key": "publisher" },
    { "package": "examples/policy-corpus/retention-2026", "key": "publisher" }
  ],
  "$comment-signNotEd25519": "Attestations §5 allows only Ed25519 keys, so moca-sign cannot sign these: the script writes the envelope itself, with RSA PKCS#1 v1.5 and SHA-256, which is deterministic.",
  "signNotEd25519": [
    { "package": "conformance/fixtures/signature-key-not-ed25519", "key": "rsa" }
  ],
  "review": [
