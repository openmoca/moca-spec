    "rogue": { "file": "fixtures/signing-keys/INSECURE-rogue.pem", "keyid": "example-rogue-2026" },
    "rsa": { "file": "fixtures/signing-keys/INSECURE-rsa.pem", "keyid": "example-rsa-2026" }
  },
  "pins": [
    { "package": "examples/handbook/handbook", "search": ["examples/handbook"] },
    { "package": "conformance/fixtures/composed-members/book", "search": ["conformance/fixtures/composed-members"] },
    { "package": "conformance/fixtures/member-other-version/v2", "search": ["conformance/fixtures/member-other-version"] }
  ],
  "sign": [
