    { "package": "conformance/fixtures/search-distance", "out": "conformance/fixtures/sidecars/distance", "chunk": "node", "variants": {
      "distance-cosine": "distance-cosine",
      "distance-dot": "distance-dot",
      "distance-euclidean": "distance-euclidean"
    } }
  ],
  "archives": [
    { "package": "conformance/fixtures/valid-minimal", "out": "conformance/fixtures/archive-minimal.zip" },
    { "package": "conformance/fixtures/valid-minimal", "out": "conformance/fixtures/archive-noncharacter.zip", "rename": { "content/hello.md": "content/hello\ufffe.md" } },
    { "package": "conformance/fixtures/valid-minimal", "out": "conformance/fixtures/archive-collision-nfc.zip", "rename": { "content/hello.md": "content/caf\u00e9.md" }, "add": { "content/cafe\u0301.md": "content/hello.md" } },
    { "package": "conformance/fixtures/valid-minimal", "out": "conformance/fixtures/archive-collision-case.zip", "rename": { "content/hello.md": "content/Hello.md" }, "add": { "content/hello.md": "content/hello.md" } },
    { "package": "conformance/fixtures/valid-minimal", "out": "conformance/fixtures/archive-collision-simple-lowercase.zip", "rename": { "content/hello.md": "content/\u0130.md" }, "add": { "content/i.md": "content/hello.md" } },
    { "package": "conformance/fixtures/valid-minimal", "out": "conformance/fixtures/archive-dotted-i.zip", "rename": { "content/hello.md": "content/\u0130.md" }, "add": { "content/i\u0307.md": "content/hello.md" } }
  ]
