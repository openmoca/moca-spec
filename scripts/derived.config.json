    { "package": "examples/acme-support", "key": "reviewer", "nodes": ["returns/refund-window.md", "returns/refund-window.fr.md", "returns/returns-policy.md", "returns/returns-policy.fr.md"], "reviewer": "human:sam.ortiz", "at": "2026-09-14T00:00:00Z", "scope": "Checked against Acme Customer Terms section 7, in English and French", "name": "sam-ortiz-2026-09-14-returns" },
    { "package": "examples/acme-support", "key": "reviewer", "nodes": ["delivery/delivery-options-and-times.md", "delivery/delivery-options-and-times.fr.md"], "reviewer": "human:sam.ortiz", "at": "2026-09-14T00:00:00Z", "scope": "Checked against Acme Customer Terms section 5, in English and French", "name": "sam-ortiz-2026-09-14-delivery" },
    { "package": "conformance/fixtures/signed-reviewed", "key": "reviewer", "nodes": ["policy.md"], "reviewer": "human:reviewer", "at": "2026-09-01T00:00:00Z", "name": "reviewer-2026-09-01" },
    { "package": "conformance/fixtures/review-wrong-role", "key": "publisher", "nodes": ["hello.md"], "reviewer": "human:publisher", "at": "2026-09-01T00:00:00Z", "name": "publisher-2026-09-01" }
