# Dependencies
node_modules/

# Build / tooling output
coverage/
*.tsbuildinfo
moca-lint.sarif

# Generated MOCA artifacts (packages and sidecars are built, never committed;
# the checked-in fixtures under examples/ are uncompressed directories)
*.moca
*.moca.idx.zip

