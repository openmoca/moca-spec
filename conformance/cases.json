    {
      "id": "search-default-policy",
      "kind": "search",
      "description": "The default retrieval policy: superseded, out-of-force and deprecated content is never returned; stale content is returned.",
      "packages": [
        "fixtures/search-policy/v1",
        "fixtures/search-policy/v2"
      ],
      "options": {
        "now": "2026-09-27T00:00:00Z",
        "backend": "lexical"
      },
      "search": {
        "query": "retention period"
      },
      "expect": {
        "include": [
          "https://example.com/conformance/search-policy@2.0.0#current.md",
          "https://example.com/conformance/search-policy@2.0.0#internal.md",
          "https://example.com/conformance/search-policy@2.0.0#stale.md"
        ],
        "exclude": [
          "https://example.com/conformance/search-policy@1.0.0#current.md",
          "https://example.com/conformance/search-policy@2.0.0#deprecated.md",
          "https://example.com/conformance/search-policy@2.0.0#expired.md"
        ]
      }
    },
    {
      "id": "search-include-all",
      "kind": "search",
      "description": "With the host's opt-in, excluded content is returned, flagged.",
      "packages": [
        "fixtures/search-policy/v1",
        "fixtures/search-policy/v2"
      ],
      "options": {
        "now": "2026-09-27T00:00:00Z",
        "backend": "lexical"
      },
      "search": {
        "query": "retention period",
        "includeAll": true
      },
      "expect": {
        "include": [
          "https://example.com/conformance/search-policy@1.0.0#current.md",
          "https://example.com/conformance/search-policy@2.0.0#current.md",
          "https://example.com/conformance/search-policy@2.0.0#internal.md",
          "https://example.com/conformance/search-policy@2.0.0#stale.md",
          "https://example.com/conformance/search-policy@2.0.0#deprecated.md",
          "https://example.com/conformance/search-policy@2.0.0#expired.md"
        ]
      }
    },
    {
      "id": "search-audience",
      "kind": "search",
      "description": "Records outside the host's audience set are removed even when the caller includes everything.",
      "packages": [
        "fixtures/search-policy/v1",
        "fixtures/search-policy/v2"
      ],
      "options": {
        "now": "2026-09-27T00:00:00Z",
        "backend": "lexical",
        "audiences": [
          "public"
        ]
      },
      "search": {
        "query": "retention period",
        "includeAll": true
      },
      "expect": {
        "include": [
          "https://example.com/conformance/search-policy@2.0.0#current.md"
        ],
        "exclude": [
          "https://example.com/conformance/search-policy@2.0.0#internal.md"
        ]
      }
    },
    {
