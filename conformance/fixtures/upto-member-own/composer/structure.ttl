@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.com/conformance/upto-composer#weeks> a skos:OrderedCollection ;
  skos:prefLabel "Weeks"@en ;
  skos:memberList ( <https://example.com/conformance/upto-composer#w1> <https://example.com/conformance/upto-composer#w2> ) .

<https://example.com/conformance/upto-composer#w1> a skos:Concept ; skos:prefLabel "Week 1"@en .
<https://example.com/conformance/upto-composer#w2> a skos:Concept ; skos:prefLabel "Week 2"@en .
