@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.com/conformance/composition-invalid-member#tides> a skos:Concept ;
  skos:prefLabel "Tides"@en ;
  dcterms:hasPart <https://example.com/conformance/source-id-duplicate>, <https://example.com/conformance/media-alternates> .

<https://example.com/conformance/source-id-duplicate> a skos:Concept ; skos:prefLabel "Two sources with one id"@en .
<https://example.com/conformance/media-alternates> a skos:Concept ; skos:prefLabel "Alternate media"@en .
