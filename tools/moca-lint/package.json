{
  "name": "@openmoca/moca-lint",
  "version": "0.1.0-beta.1",
  "description": "Static analysis CLI for MOCA package directories and .moca archives.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "moca-lint": "./bin/moca-lint.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "@openmoca/moca-sign": "^0.1.0-beta.1",
    "n3": "^1.24.1",
    "picocolors": "^1.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmoca/moca-spec.git",
    "directory": "tools/moca-lint"
  },
  "homepage": "https://github.com/openmoca/moca-spec/tree/main/tools/moca-lint#readme",
  "bugs": {
    "url": "https://github.com/openmoca/moca-spec/issues"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  }
}
