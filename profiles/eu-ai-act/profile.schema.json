{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moca/profiles/eu-ai-act/v1/profile.schema.json",
  "title": "MOCA EU AI Act data-governance profile data",
  "type": "object",
  "required": [
    "regulation",
    "dataGovernance"
  ],
  "properties": {
    "regulation": {
      "type": "string",
      "minLength": 1
    },
    "dataGovernance": {
      "type": "object",
      "required": [
        "sources",
        "personalData"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "collectionPeriod": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "preparation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knownGaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "personalData": {
          "enum": [
            "none",
            "pseudonymised",
            "present"
          ]
        }
      },
      "additionalProperties": false
    },
    "syntheticContent": {
      "type": "object",
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "marking": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
