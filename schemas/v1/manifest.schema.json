{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moca/schemas/v1/manifest.schema.json",
  "title": "MOCA package manifest (moca.json)",
  "description": "Normative schema for moca.json. See spec/moca-package-spec.md section 4.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mocaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?![\\s\\S])",
      "description": "The MOCA specification version the package was written against, major.minor."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
      "description": "Absolute URI naming the package across all its versions. https: or tag: URIs are recommended. It never contains #: a node identifier is the id, #, and the node path.",
      "not": {
        "pattern": "#"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])",
      "description": "Content version, following the content-versioning rules in spec section 4.3."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])",
      "description": "BCP 47 tag of the default-language content."
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
      },
      "uniqueItems": true,
      "description": "BCP 47 tags of additional locale variants, see spec section 5.4."
    },
    "license": {
      "type": "string",
      "description": "SPDX license expression."
    },
    "publisher": {
      "type": "string"
    },
    "distribution": {
      "enum": ["open", "encrypted-only", "service-only"],
      "description": "How the publisher intends the package to be handed out. A label, not access control. Absent means open."
    },
    "images": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/image"
      },
      "description": "Pictures of the package for a catalogue: package files under media/, each with a role. See spec section 4.6."
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/translation"
      },
      "description": "The manifest's title, description, tags and image alt text in other languages, keyed by a tag in locales. See spec section 4.7."
    },
    "tags": {
      "$ref": "#/$defs/tags",
      "description": "Short plain labels in the default language. See spec section 4.8."
    },
    "apps": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[^/?#\\t\\n\\v\\f\\r    -     　﻿][^\\t\\n\\v\\f\\r    -     　﻿]*(?![\\s\\S])"
          },
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
          }
        ]
      },
      "description": "Where the publisher suggests the package is opened, beyond conversation: https: URIs naming apps and app-type tokens, first preferred. Advice only; never fetched. See spec section 4.9."
    },
    "readingOrder": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
      "description": "The IRI of the skos:OrderedCollection in the package's own structure.ttl that orders the whole package. See spec section 4.10."
    },
    "validFrom": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ],
      "description": "When the package's content comes into force."
    },
    "validUntil": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ],
      "description": "When the package's content stops being in force."
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "description": "Ordered packages this package is composed of, each pinned by digest."
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object"
      },
      "description": "Profile URI -> that profile's package-level data."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "member": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
          "not": {
            "pattern": "#"
          },
          "description": "A package id; never contains #."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "supersedes | amends | conflictsWith | crossReferences, or a profile-defined type."
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
          "not": {
            "pattern": "#"
          },
          "description": "A package id; never contains #."
        },
        "version": {
          "type": "string",
          "description": "Optional exact version of the target the relation applies to.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "src",
        "role",
        "type"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^media(?:/[^/\\\\]+)+(?![\\s\\S])",
          "not": {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          },
          "description": "A package path to a regular file under media/. Never a URL."
        },
        "role": {
          "enum": [
            "icon",
            "cover"
          ]
        },
        "type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "sizes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*(?: [1-9][0-9]*x[1-9][0-9]*)*(?![\\s\\S])",
          "description": "Pixel sizes, informative."
        },
        "alt": {
          "$ref": "#/$defs/alt"
        }
      },
      "additionalProperties": false
    },
    "alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
      }
    },
    "translation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "alt": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/alt"
          },
          "description": "An image's src to its alt text in this language."
        }
      },
      "additionalProperties": false
    }
  }
}
