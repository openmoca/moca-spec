{
  "$schema": "https://openmoca.org/schemas/core/moca.schema.json",
  "@context": {
    "moca": "https://openmoca.org/vocab/core#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "ex": "https://example.org/vocab#"
  },
  "id": "urn:moca:example:level-2-semantic",
  "version": "1.0.0",
  "title": "Level 2 Semantic Example",
  "description": "MOCA Core package demonstrating Level 2 (MOCA Semantic) conformance: JSON-LD @context, formal ontologies, SHACL validation, and an explicit claims graph.",
  "license": "MIT",
  "ontologies": {
    "domain": {
      "iri": "https://example.org/architecture",
      "role": "domain",
      "format": "jsonld",
      "uri": "./ontologies/domain.jsonld"
    },
    "shapes": {
      "role": "shapes",
      "format": "shacl",
      "uri": "./ontologies/validation.shacl.ttl"
    }
  },
  "entryConcepts": ["ex:ServiceBoundary"]
}
